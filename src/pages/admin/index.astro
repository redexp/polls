---
import Base from '../../layouts/Base.astro';
import LoginModal from '../../components/LoginModal.astro';
import InfoModal from '../../components/InfoModal.astro';
import './_style.less';
---

<Base title="Опитування — адмінка">
    <main class="container py-4 admin">
        <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
            <h1 class="h3 m-0">Опитування</h1>

            <a href="/admin/edit/" class="btn btn-primary">Створити опитування</a>
        </div>

        <div id="empty" class="alert alert-secondary d-none">
            Опитувань ще немає.
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Заголовок</th>
                        <th>Стан</th>
                        <th class="text-end">Голосів</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="polls">
                    <tr>
                        <td>
                            <a data-title href="#"></a>
                            <div data-error class="text-danger small"></div>
                        </td>
                        <td>
                            <span class="d-flex flex-wrap gap-1">
                                <span data-draft class="badge text-bg-warning">Чернетка</span>
                                <span data-active class="badge"></span>
                                <span data-public class="badge"></span>
                            </span>
                        </td>
                        <td class="text-end"><strong data-votes></strong></td>
                        <td>
                            <span class="d-flex flex-wrap justify-content-end gap-2">
                                <a data-edit href="#" class="btn btn-sm btn-info">Редагувати</a>
                                <button data-copy type="button" class="btn btn-sm btn-light"
                                        title="Скопіювати посилання на опитування">Посилання</button>
                                <button data-delete type="button" class="btn btn-sm btn-outline-danger">Видалити</button>
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <section class="card p-3 mt-4">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h2 class="h5 m-0 d-flex align-items-center gap-2">
                    Публікація

                    <button type="button" class="btn-help" data-help="help-publish"
                            aria-label="Пояснення про публікацію">?</button>
                </h2>

                <button id="publish" type="button" class="btn btn-success">Опублікувати сайт</button>
            </div>

            <pre id="log" class="bg-body-secondary p-3 small mb-3 d-none"></pre>

            <h3 class="h6">Збірки</h3>

            <ul id="builds" class="list-group list-group-flush">
                <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2 px-0">
                    <code data-name></code>
                    <span class="d-flex align-items-center gap-2">
                        <span data-current class="badge text-bg-success">Активна</span>
                        <button data-rollback type="button" class="btn btn-sm btn-outline-secondary">Відкатити</button>
                    </span>
                </li>
            </ul>
        </section>
    </main>

    <template id="help-publish">
        <p>
            Публікація збирає сайт заново в окрему теку і переставляє його на цю нову збірку.
            Якщо збірка впаде, сайт лишиться на попередній версії.
        </p>
        <p class="mb-0">
            Чернетки у збірку не потрапляють. Зберігаються 3 останні збірки — на будь-яку з них
            можна відкотитись кнопкою «Відкатити».
        </p>
    </template>

	<LoginModal/>
	<InfoModal/>
</Base>

<script>
	import './_controller.ts';
</script>
